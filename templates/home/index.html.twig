{% extends 'base.html.twig' %}

{% block title %}Accueil - Événements{% endblock %}

{% block body %}
    <h1>Événements à venir</h1>

    {# Filtres par catégorie #}
<div class="categories-filter">
    <a href="{{ path('app_home') }}" class="{{ selectedCategory is null ? 'active' : '' }}">Tous</a>
    {% for cat in categories %}
        <a href="{{ path('app_home', {'category': cat.value}) }}" 
           class="{{ selectedCategory == cat.value ? 'active' : '' }}">
            {{ cat.label is defined ? cat.label() : cat.value }}
        </a>
    {% endfor %}
</div>

    {# Liste des événements #}
    <div class="events-grid">
        {% for event in events %}
            <div class="card event-card {{ event.nombreDePlaces == 0 ? 'is-full' : '' }}">
                {% if event.image %}
                    <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.titre }}">
                {% else %}
                    <img src="{{ asset('images/default.jpg') }}" alt="Image par défaut">
                {% endif %}

                <h2>{{ event.titre }}</h2>
                <p><strong>Date :</strong> {{ event.date|date('d/m/Y H:i') }}</p>
                <p><strong>Places :</strong> 
                    {% if event.nombreDePlaces == 0 %}
                        <span class="badge badge-full">Complet</span>
                    {% else %}
                        {{ event.nombreDePlaces }}
                    {% endif %}
                </p>

                <a href="{{ path('app_event_show', {'id': event.id}) }}" class="btn">Voir le détail</a>
            </div>
        {% else %}
            <p>Aucun événement disponible pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}