{% extends 'base.html.twig' %}

{% block title %}{{ event.titre }}{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

        <div class="card">
            {# Image de l'événement #}
            {% if event.image %}
                <img src="{{ asset('uploads/events/' ~ event.image) }}" alt="{{ event.titre }}" class="event-detail-image">
            {% else %}
                <img src="{{ asset('images/default.jpg') }}" alt="Image par défaut" class="event-detail-image">
            {% endif %}

            <h1>{{ event.titre }}</h1>

            <div class="event-meta">
                <p><strong>Catégorie :</strong> {{ event.category ? event.category.label : 'Non catégorisé' }}</p>
                <p><strong>Date :</strong> {{ event.date ? event.date|date('d/m/Y à H:i') : 'Date non précisée' }}</p>
                <p><strong>Places restantes :</strong> {{ event.nombreDePlaces }}</p>
                
                {# Badge de statut si besoin #}
                {% if not event.isValidated %}
                    <p><span class="badge badge-warning">En attente de validation</span></p>
                {% endif %}
            </div>

            <hr>

            <div class="event-description">
                <h2>Informations</h2>
                <p>{{ event.informations|nl2br }}</p>
            </div>
        </div>
    </div>
    <div class="event-actions">
    {% if app.user %}
        {% if event.users.contains(app.user) %}
            <a href="{{ path('app_event_unsubscribe', {'id': event.id}) }}" class="btn btn-danger">
                Se désinscrire
            </a>
        {% elseif event.nombreDePlaces > 0 %}
            <a href="{{ path('app_event_subscribe', {'id': event.id}) }}" class="btn btn-primary">
                S'inscrire
            </a>
        {% else %}
            <span class="badge badge-full">Complet</span>
        {% endif %}
    {% else %}
        <p><a href="{{ path('app_login') }}">Connectez-vous</a> pour vous inscrire à cet événement.</p>
    {% endif %}
</div>
{% endblock %}