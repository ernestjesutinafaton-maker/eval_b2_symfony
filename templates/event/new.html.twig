{% extends 'base.html.twig' %}

{% block title %}Ajouter un événement{% endblock %}

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

        <div class="card">
            <h1>Ajouter un événement</h1>
            <p class="muted">Votre événement sera visible après validation par un administrateur.</p>
            {{ form_start(form, {'attr': {'class': 'form'}}) }}

                {#
                    form_widget(form) affiche tous les champs du formulaire.
                    Chaque champ est rendu dans un <div> avec son label, son widget
                    et ses messages d'erreur (ceux de tes contraintes NotBlank, Positive…).
                    Réf. : https://symfony.com/doc/7.4/reference/forms/twig_reference.html#form-widget-view-variables
                #}
                {{ form_widget(form) }}

                <button type="submit">Enregistrer l'événement</button>

            {# form_end() ferme la balise et affiche les champs non encore rendus #}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}